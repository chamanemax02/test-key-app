<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Glowing Gradient Circular Ring -->
    <path
        android:pathData="M64,8 A56,56 0 1,0 64,120 A56,56 0 1,0 64,8 Z"
        android:strokeWidth="4">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="8"
                android:startY="8"
                android:endX="120"
                android:endY="120"
                android:type="linear">
                <item android:color="#8B5CF6" android:offset="0.0" />
                <item android:color="#EC4899" android:offset="0.5" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sound Wave Bars -->
    <path
        android:pathData="M28,64 L28,64 M37,50 L37,78 M46,40 L46,88 M55,30 L55,98 M64,22 L64,106 M73,30 L73,98 M82,40 L82,88 M91,50 L91,78 M100,64 L100,64"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="64"
                android:endX="100"
                android:endY="64"
                android:type="linear">
                <item android:color="#8B5CF6" android:offset="0.0" />
                <item android:color="#EC4899" android:offset="0.5" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
